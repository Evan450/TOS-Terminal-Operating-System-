-- FEAT-4 — example kiosk configuration.
-- Copy this to /etc/kiosk.cfg and edit to taste. The kiosk shell loads
-- /etc/kiosk.cfg (or falls back to defaults) when a user named "kiosk"
-- logs in.
--
-- Schema is documented in tos/shell/kiosk.lua. Every field is optional;
-- missing or malformed entries fall back to safe defaults.
return {
  banner  = "Welcome to the front-desk kiosk — type 'help' or pick a number.",

  -- Allowed commands. The kiosk dispatch refuses anything not on this
  -- list, even if the regular shell has it registered. Keep it short.
  allowed = {
    "help", "ls", "cat", "date", "time", "echo", "whoami", "logout",
  },

  -- Menu items shown on the kiosk's main screen. Selecting a number
  -- key runs the corresponding `cmd` through the kiosk dispatcher
  -- (so the cmd's first token still has to be in `allowed`).
  menu = {
    { label = "Show today's date",       cmd = "date" },
    { label = "Building map (text)",     cmd = "cat /public/map.txt" },
    { label = "About this kiosk",        cmd = "echo Provided by Strata Systems" },
  },

  -- Idle timeout in seconds. After this long without keystrokes the
  -- kiosk clears the screen and returns to the menu — useful for
  -- public displays where someone might wander off mid-command.
  idleSeconds = 60,
}
